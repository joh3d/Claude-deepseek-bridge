#!/usr/bin/env python3
"""
Claude-DeepSeek Bridge — /deepseek
Delegates routine and boilerplate tasks to DeepSeek Flash (fast & cost-efficient).

Usage:
    /deepseek <prompt>
    cat file.py | /deepseek "Write unit tests for this"
    git diff | /deepseek "Summarize changes"
"""

import sys
import os
import json
import urllib.request
import urllib.error

# Ensure UTF-8 output across all OS consoles (Windows CP1252/OEM, etc.)
if hasattr(sys.stdout, "reconfigure"):
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

DEFAULT_BASE_URL = "https://api.deepseek.com"
DEFAULT_MODEL = "deepseek-v4-flash"  # Fallback: deepseek-chat


def get_api_key():
    return os.getenv("DEEPSEEK_API_KEY")


def get_base_url():
    base = os.getenv("DEEPSEEK_BASE_URL", DEFAULT_BASE_URL).rstrip("/")
    if not base.endswith("/v1") and not base.endswith("/chat/completions"):
        return f"{base}/chat/completions"
    elif base.endswith("/v1"):
        return f"{base}/chat/completions"
    return base


def get_model():
    return os.getenv("DEEPSEEK_MODEL", DEFAULT_MODEL)


def parse_args_and_input():
    args = sys.argv[1:]
    model = get_model()
    stream = True
    temperature = 0.7
    custom_prompt_parts = []

    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            print_help()
            sys.exit(0)
        elif arg in ("-m", "--model") and i + 1 < len(args):
            model = args[i + 1]
            i += 2
            continue
        elif arg == "--no-stream":
            stream = False
            i += 1
            continue
        elif arg in ("-t", "--temperature") and i + 1 < len(args):
            try:
                temperature = float(args[i + 1])
            except ValueError:
                pass
            i += 2
            continue
        else:
            custom_prompt_parts.append(arg)
            i += 1

    prompt = " ".join(custom_prompt_parts).strip()

    # Read from stdin if piped
    stdin_content = ""
    if not sys.stdin.isatty():
        try:
            stdin_content = sys.stdin.read().strip()
        except Exception:
            stdin_content = ""

    if stdin_content:
        if prompt:
            full_prompt = f"{prompt}\n\n```\n{stdin_content}\n```"
        else:
            full_prompt = stdin_content
    else:
        full_prompt = prompt

    return full_prompt, model, stream, temperature


def print_help():
    print("""Claude-DeepSeek Bridge — /deepseek

Usage:
  /deepseek [options] <prompt>
  cat file.txt | /deepseek [options] [prompt]

Options:
  -h, --help               Show this help message
  -m, --model <name>       Override model (default: DEEPSEEK_MODEL or deepseek-v4-flash)
  -t, --temperature <val>  Sampling temperature (default: 0.7)
  --no-stream              Disable real-time streaming output

Environment Variables:
  DEEPSEEK_API_KEY         Required DeepSeek API Key
  DEEPSEEK_BASE_URL        Optional custom API base URL (default: https://api.deepseek.com)
  DEEPSEEK_MODEL           Optional default model name
""")


def stream_request(url, headers, payload):
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method="POST"
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        for raw_line in resp:
            line = raw_line.decode("utf-8").strip()
            if not line:
                continue
            if line.startswith("data:"):
                data_str = line[5:].strip()
                if data_str == "[DONE]":
                    break
                try:
                    chunk = json.loads(data_str)
                    delta = chunk.get("choices", [{}])[0].get("delta", {})
                    content = delta.get("content", "")
                    if content:
                        sys.stdout.write(content)
                        sys.stdout.flush()
                except json.JSONDecodeError:
                    continue
        sys.stdout.write("\n")
        sys.stdout.flush()


def non_stream_request(url, headers, payload):
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method="POST"
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        body = resp.read().decode("utf-8")
        data = json.loads(body)
        content = data["choices"][0]["message"]["content"]
        print(content)


def main():
    prompt, model, stream, temperature = parse_args_and_input()

    if not prompt:
        print_help()
        sys.exit(1)

    api_key = get_api_key()
    if not api_key:
        print("Error: DEEPSEEK_API_KEY environment variable is not set.", file=sys.stderr)
        print("Set it via:", file=sys.stderr)
        print("  Linux/macOS: export DEEPSEEK_API_KEY='your-key-here'", file=sys.stderr)
        print("  Windows PS:  $env:DEEPSEEK_API_KEY='your-key-here'", file=sys.stderr)
        print("Or run the setup script: bash setup.sh  (or .\\setup.ps1)", file=sys.stderr)
        sys.exit(1)

    url = get_base_url()
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
        "Accept": "text/event-stream" if stream else "application/json",
        "User-Agent": "Claude-DeepSeek-Bridge/1.0"
    }

    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": temperature,
        "stream": stream,
    }

    try:
        if stream:
            stream_request(url, headers, payload)
        else:
            non_stream_request(url, headers, payload)
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")
        if e.code == 401:
            print(f"Error 401: Invalid or expired DeepSeek API key.", file=sys.stderr)
        elif e.code == 402:
            print(f"Error 402: Insufficient DeepSeek account balance.", file=sys.stderr)
        elif e.code == 429:
            print(f"Error 429: Rate limit exceeded. Please retry shortly.", file=sys.stderr)
        else:
            print(f"DeepSeek API Error ({e.code}): {err_body}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Error connecting to DeepSeek API ({url}): {e.reason}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Unexpected error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()